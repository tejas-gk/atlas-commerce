    "start": "node dist/main.js"
  },
  "dependencies": {
    "@repo/db": "workspace:^",
    "@repo/error-handler": "workspace:^",
    "@repo/middleware": "workspace:^",
    "@repo/redis": "workspace:^"
  }
}
