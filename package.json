{
  "name": "atlas-commerce",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "kafka:up": "docker compose -f docker-compose.production.yml up kafka zookeeper -d",
    "kafka:down": "docker compose -f docker-compose.production.yml stop kafka zookeeper -d",
    "kafka:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "kafka:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "bash scripts/local-production.sh",
    "docker:build": "bash scripts/local-production.sh --build-only",
    "docker:run": "bash scripts/local-production.sh --run-only",
    "docker:stop": "bash scripts/local-production.sh --stop",
    "docker:clean": "bash scripts/local-production.sh --clean",
    "docker:logs": "bash scripts/local-production.sh --logs"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "@turbo/gen": "^2.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/react-image-magnify": "^2.7.4",
    "@types/react-simple-maps": "^3.0.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.3.3",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "emoji-picker-react": "^4.18.0",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.38.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.9.3",
    "jotai": "^2.19.0",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.1",
    "node-cron": "^4.2.1",
    "prisma": "6.19.0",
    "react-apexcharts": "^2.1.0",
    "react-hook-form": "^7.71.2",
    "react-hot-toast": "^2.6.0",
    "react-image-magnify": "^2.7.4",
    "react-quill-new": "^3.8.3",
    "react-range": "^1.10.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "stripe": "^12.0.0",
    "styled-components": "^6.3.12",
    "swagger-ui-express": "^5.0.1",
